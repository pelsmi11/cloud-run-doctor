# Cloud Run Doctor — canonical configuration (FR-048)
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=pawpass-gdg-demo
GOOGLE_CLOUD_LOCATION=global
DOCTOR_MODEL=gemini-3.7-flash
DOCTOR_THINKING_LEVEL=LOW
PAWPASS_SERVICE=pawpass
