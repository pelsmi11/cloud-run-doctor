MONITORING_MCP_ENABLED=false
LOG_DEFAULT_WINDOW_MIN=60
LOG_MAX_ENTRIES=20
SESSION_LOG_WINDOW_MIN=1440
SESSION_LOG_MAX_ENTRIES=100
